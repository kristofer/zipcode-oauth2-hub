# Build stage
FROM golang:1.21-alpine AS builder

ARG VERSION=dev

WORKDIR /app

# Copy go mod files from project root
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire project
COPY . .

# Build the productivity-app1 portal
WORKDIR /app/examples/productivity-app1
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.version=${VERSION}" \
    -a -installsuffix cgo \
    -o /app/portal-app \
    .

# Runtime stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates wget tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/portal-app .

# Expose the application port
EXPOSE 9204

# Run the application
CMD ["./portal-app"]
