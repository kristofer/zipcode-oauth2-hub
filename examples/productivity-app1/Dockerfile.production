# Build stage
FROM golang:1.21-alpine AS builder

ARG VERSION=dev

WORKDIR /app

# Copy go mod files from project root
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire project (needed for shared packages/imports)
COPY . .

# Build the productivity-app1 portal
WORKDIR /app/examples/productivity-app1
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.version=${VERSION}" \
    -a -installsuffix cgo \
    -o /app/portal-app \
    .

# Runtime stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates wget tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/portal-app .

# Copy static assets if they exist (templates, css, js, etc.)
COPY --from=builder /app/examples/productivity-app1/static ./static 2>/dev/null || true
COPY --from=builder /app/examples/productivity-app1/templates ./templates 2>/dev/null || true
COPY --from=builder /app/examples/productivity-app1/assets ./assets 2>/dev/null || true
COPY --from=builder /app/examples/productivity-app1/public ./public 2>/dev/null || true

# Expose the application port
EXPOSE 9204

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:9204/health || exit 1

# Run the application
CMD ["./portal-app"]
