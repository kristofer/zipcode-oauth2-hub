# Build stage
FROM golang:1.21-alpine AS builder

ARG PORTAL_PATH
ARG VERSION=dev

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire project (needed for module resolution)
COPY . .

# Build the specific portal application
WORKDIR /app/${PORTAL_PATH}
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.version=${VERSION}" \
    -o /app/portal-app \
    .

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates wget

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/portal-app .

# Copy any static assets if they exist
COPY --from=builder /app/${PORTAL_PATH}/static ./static 2>/dev/null || true
COPY --from=builder /app/${PORTAL_PATH}/templates ./templates 2>/dev/null || true

EXPOSE 9204

CMD ["./portal-app"]
