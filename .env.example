# ZipCode OAuth2 Hub Environment Configuration
# Copy this file to .env and customize as needed
# None of these passwords are real.

# =============================================================================
# Keycloak Configuration
# =============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=zipcodewilmington

# Keycloak Database Configuration (for Docker setup)
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_pass

# Keycloak Admin Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =============================================================================
# API Gateway Configuration
# =============================================================================
GATEWAY_PORT=8081
GATEWAY_HOST=localhost

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keycloak
DB_USER=keycloak
DB_PASSWORD=keycloak_pass

# =============================================================================
# OAuth2 Client Configuration
# =============================================================================
# Default client for example applications
CLIENT_ID=productivity-app-frontend
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/callback

# JWT Configuration
JWT_ISSUER=http://localhost:8080/realms/zipcodewilmington

# =============================================================================
# Application Configuration
# =============================================================================
APP_PORT=3000
NODE_ENV=development

# =============================================================================
# Educational Features Configuration
# =============================================================================
# Default cohort settings
DEFAULT_COHORT=2024-fall-bootcamp
ENABLE_TIME_POLICIES=true
ENABLE_COHORT_ISOLATION=true

# Exam and assignment timing
EXAM_BUFFER_MINUTES=15
LAB_HOURS_START=08:00
LAB_HOURS_END=20:00

# =============================================================================
# Security Configuration
# =============================================================================
# Session configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_TIMEOUT=3600

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900  # 15 minutes
RATE_LIMIT_MAX=100     # Max requests per window

# =============================================================================
# Monitoring and Logging
# =============================================================================
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# External Services (Optional)
# =============================================================================
# Email service for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# File storage for assignments
STORAGE_TYPE=local  # Options: local, s3, azure
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =============================================================================
# Development Settings
# =============================================================================
# Enable development features
DEBUG_MODE=true
HOT_RELOAD=true
CORS_ORIGIN=*

# Mock data settings
USE_MOCK_DATA=true
MOCK_STUDENT_COUNT=25
MOCK_INSTRUCTOR_COUNT=3

# =============================================================================
# Production Overrides
# =============================================================================
# Uncomment and set these for production deployment
# KEYCLOAK_URL=https://auth.yourinstitution.edu
# GATEWAY_HOST=api.yourinstitution.edu
# DB_HOST=your-postgres-host
# REDIS_URL=your-redis-host:6379
# SESSION_SECRET=your-secure-random-session-secret
# CORS_ORIGIN=https://yourinstitution.edu
# DEBUG_MODE=false
# USE_MOCK_DATA=false